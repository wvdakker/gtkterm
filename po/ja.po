#: src/cmdline.c:41
msgid ""
"\n"
"Command line options\n"
msgstr ""
"\n"
"コマンドラインオプション\n"

#: src/cmdline.c:42
msgid "--help or -h: this help screen\n"
msgstr "--help または -h: このヘルプ画面\n"

#: src/cmdline.c:43
msgid "--config <configuration> or -c: load configuration\n"
msgstr "--config <configuration> または -c: 設定を読み込む\n"

#: src/cmdline.c:44
msgid "--port <device> or -p: serial port device (default /dev/ttyS0)\n"
msgstr ""
"--port <device> または -p: シリアルポートデバイス (デフォルトは /dev/ttyS0)\n"

#: src/cmdline.c:45
msgid "--speed <speed> or -s: serial port speed (default 9600)\n"
msgstr ""
"--speed <speed> または -s: シリアルポートの伝送速度 (デフォルトは 9600)\n"

#: src/cmdline.c:46
msgid "--bits <bits> or -b: number of bits (default 8)\n"
msgstr "--bits <bits> または -b: ビットの数 (デフォルトは 8)\n"

#: src/cmdline.c:47
msgid "--stopbits <stopbits> or -t: number of stopbits (default 1)\n"
msgstr "--stopbits <stopbits> または -t: ストップビットの数 (デフォルトは 1)\n"

#: src/cmdline.c:48
msgid "--parity <odd | even> or -a: parity (default none)\n"
msgstr "--parity <odd | even> または -a: パリティ (デフォルトは none)\n"

#: src/cmdline.c:49
msgid "--flow <Xon | RTS | RS485> or -w: flow control (default none)\n"
msgstr "--flow <Xon | RTS | RS485> または -w: フロー制御 (デフォルトは none)\n"

#: src/cmdline.c:50
msgid "--delay <ms> or -d: end of line delay in ms (default none)\n"
msgstr "--delay <ms> または -d: 送信遅延 (ミリ秒) (デフォルトは none)\n"

#: src/cmdline.c:51
msgid ""
"--char <char> or -r: wait for a special char at end of line (default none)\n"
msgstr ""
"--char <char> または -r: 次の行へ移動する前に必要とする特殊文字 (デフォルト"
"は none)\n"

#: src/cmdline.c:52
msgid "--file <filename> or -f: default file to send (default none)\n"
msgstr ""
"--file <filename> または -f: 送信するデフォルトのファイル (デフォルトは "
"none)\n"

#: src/cmdline.c:53
msgid ""
"--rts_time_before <ms> or -x: for RS-485, time in ms before transmit with "
"rts on\n"
msgstr ""
"--rts_time_before <ms> または -x: RS-485 の場合に、送信前に RTS を on にする"
"時間 (ミリ秒)\n"

#: src/cmdline.c:54
msgid ""
"--rts_time_after <ms> or -y: for RS-485, time in ms after transmit with rts "
"on\n"
msgstr ""
"--rts_time_after <ms> または -y: RS-485 の場合に、送信後に RTS を on にする時"
"間 (ミリ秒)\n"

#: src/cmdline.c:55
msgid "--echo or -e: switch on local echo\n"
msgstr "--echo または -e: ローカルエコーを有効にする\n"

#: src/cmdline.c:56
msgid ""
"--disable-port-lock or -L: does not lock serial port. Allows to send to "
"serial port from different terminals\n"
msgstr ""
"--disable-port-lock または -L: シリアルポートをロックしない。別の端末からシリ"
"アルポートに送信できるようにする\n"

#: src/cmdline.c:57
msgid ""
"                      Note: incoming data are displayed randomly on only one "
"terminal\n"
msgstr ""
"                      注意: 受信したデータは、いずれかの端末にのみランダムに"
"表示される\n"

